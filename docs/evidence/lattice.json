  "method": {
    "layers": "from station 0; the next at 6 m, or 4 m when the reference curves more than 0.02 1/m anywhere in the 6 m ahead; a last gap longer than its spacing split in two",
    "nodes": "whole multiples of 0.5 m along the layer's left normal, within the corridor (track edges or half the width) less 0.9 m each side; reference node at offset 0",
    "node_slope": "0 at the reference; toward an edge, offset / usable limit times that edge's own slope (corridor edge rate by central difference over +-1 m)",
    "edges": "to every node of the next layer with |d1 - (d0 + slope0 * L)| <= 0.3 * L; offset = quintic Hermite in station with node slopes and zero second derivative at both ends",
    "curvature": "(P (k P + d'') + d' (k' d + 2 k d')) / (P^2 + d'^2)^(3/2), P = 1 - k d; k and k' interpolated from the reference's samples",
    "removal_order": [
      "curvature beyond tan(max_steering_rad)/wheelbase_m or P <= 0",
      "any sample outside the corridor less 0.9 m",
      "dead ends, iteratively"
    ],
    "offline_cost": "7500 mean|curvature|^2 L + 2500 (max-min curvature)^2 L + 0 L + min(10000 |d_end|, 10000) L",
    "reference_normal": "chord through the reference 0.25 m either side"
  },
