  "method": {
    "variables": "alpha_i, the shift of sample i along the conditioned centreline's left normal (left positive, the project's convention; TUM's normals point right)",
    "curvature": "kappa_i + (alpha_{i-1} - 2 alpha_i + alpha_{i+1}) / ds^2 + kappa_i^2 alpha_i, linearised about the current reference",
    "objective": "sum of squared linearised curvature plus 1e-12 / ds^4 times the squared shifts, a regularisation that only makes the minimum unique where curvature is indifferent",
    "bounds": "each shift within the corridor's edge at that sample less vehicle_half_width_m 0.9 and margin_m 0.6",
    "steering": "each linearised curvature within 0.98 tan(max_steering_rad) / wheelbase_m; an infeasible problem is refused naming the limit",
    "iteration": "the shifted points are conditioned again at the same spacing (smoothing 0.001 m rms, corridor checks off) and the problem re-linearised until the largest shift is below 0.02 m, at most 30 times",
    "output": "a Track accepted by validate_track, with curvature and per-sample left_edge_m and right_edge_m: the corridor's edges at the sample's projection onto the centreline, less its signed offset",
    "estimate": "fd::estimated_lap_time: each span at constant acceleration between planned speeds, the closing span included"
  },
